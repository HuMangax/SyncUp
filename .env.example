# Demo mode: shows the DemoPanel and forces simulated calendar + local store
NEXT_PUBLIC_DEMO=1

# AI breakdown (server-side only). Optional: without a key the app uses the template fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Gemini works as a second model (or the main one with AI_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=

# Persistence (stretch). Without these the app uses the local store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (stretch)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string; encrypts the Google refresh token cookie (server only)
GOOGLE_TOKEN_SECRET=
